{
  "manifest_version": 3,
  "name": "Tabmason",
  "version": "0.2.0",
  "description": "Auto-sort Chrome tabs into the groups you define, with rules, learning and an optional AI fallback.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Tabmason"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "group-by-domain": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Group tabs in this window by domain"
    }
  }
}
