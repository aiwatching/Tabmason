{
  "manifest_version": 3,
  "name": "Tabmason",
  "version": "0.4.0",
  "description": "Auto-sort Chrome tabs into the groups you define, with rules, learning and an optional AI fallback.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "scripting",
    "favicon",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "src/content/mark.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Tabmason"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "group-by-domain": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Group tabs in this window by domain"
    },
    "open-overview": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Open the tab overview"
    }
  }
}
