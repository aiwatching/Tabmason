{
  "manifest_version": 3,
  "name": "Tabmason",
  "version": "0.1.0",
  "description": "Smart tab management: group, tidy and park your Chrome tabs.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "src/popup/popup.html", "default_title": "Tabmason" },
  "options_page": "src/options/options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "group-by-domain": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Group tabs in this window by domain"
    }
  }
}
